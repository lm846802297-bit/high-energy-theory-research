{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/high-energy-theory/v1.4.3.6/task_execution_contract.schema.json",
  "title": "Task Execution Contract schema (v1.4.3.6 integrated candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "project_id",
    "contract_id",
    "task_id",
    "contract_version",
    "contract_status",
    "objective",
    "scope",
    "input_refs",
    "assumptions",
    "conventions_id",
    "conventions_reason",
    "required_capabilities",
    "planned_methods",
    "artifact_plan_ids",
    "validation_plan_ids",
    "acceptance_criteria",
    "failure_branches",
    "stop_conditions",
    "contract_sha256",
    "created_at",
    "approved_at",
    "approved_by",
    "supersedes_contract_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.4"
    },
    "record_type": {
      "const": "task_execution_contract"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_hash": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "integer",
      "minimum": 0
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded",
        "cancelled"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "input_refs": {
      "$ref": "#/$defs/inputRefs"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "conventions_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "conventions_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "planned_methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      }
    },
    "artifact_plan_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "validation_plan_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "failure_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes_contract_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "alternative_identity_methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/alternativeIdentityMethod"
      },
      "description": "Optional contract-versioned registry of approved alternative identity methods."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "target_domain",
        "out_of_scope_behavior"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_domain": {
          "type": "string",
          "minLength": 1
        },
        "out_of_scope_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids",
        "configuration_ids",
        "input_artifact_ids",
        "external_references"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "configuration_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "input_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "external_references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "external_system",
              "external_id",
              "uri",
              "version_or_revision",
              "retrieved_at",
              "content_sha256",
              "hash_unavailable_reason"
            ],
            "properties": {
              "external_system": {
                "type": "string",
                "minLength": 1
              },
              "external_id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "version_or_revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retrieved_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256OrNull"
              },
              "hash_unavailable_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "description",
        "required",
        "verification_method",
        "pass_condition",
        "failure_condition",
        "evidence_kind"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        },
        "pass_condition": {
          "type": "string",
          "minLength": 1
        },
        "failure_condition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {},
        "comparison_operator": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "tolerance_basis": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "threshold"
            ]
          },
          "then": {
            "required": [
              "comparison_operator",
              "unit",
              "tolerance_basis"
            ]
          }
        }
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "description",
        "scope",
        "status",
        "source_or_rationale"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "source_or_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "description",
        "scope",
        "status",
        "source_or_rationale"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "source_or_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alternativeIdentityMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "method_version",
        "method_kind",
        "method_status",
        "description",
        "applicable_source_types",
        "applicable_artifact_storage_kinds",
        "identity_value_specification",
        "verification_procedure",
        "required_evidence_kinds",
        "acceptance_criteria",
        "limitations"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "pattern": "^AIM-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "method_version": {
          "type": "integer",
          "minimum": 1
        },
        "method_kind": {
          "type": "string",
          "enum": [
            "publisher_checksum",
            "signed_manifest",
            "content_addressed_identifier",
            "immutable_versioned_locator",
            "repository_revision",
            "archive_catalogue_record",
            "other"
          ]
        },
        "method_status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "retired"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "applicable_source_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applicable_artifact_storage_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          }
        },
        "identity_value_specification": {
          "type": "string",
          "minLength": 1
        },
        "verification_procedure": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_status": {
            "const": "approved"
          }
        },
        "required": [
          "contract_status"
        ]
      },
      "then": {
        "properties": {
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "approved_at",
          "approved_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "conventions_id": {
            "type": "null"
          }
        },
        "required": [
          "conventions_id"
        ]
      },
      "then": {
        "properties": {
          "conventions_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "conventions_reason"
        ]
      }
    }
  ]
}
