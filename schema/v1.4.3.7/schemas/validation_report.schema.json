{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/high-energy-theory/v1.4.2/validation_report.schema.json",
  "title": "validation_report record schema (v1.4.2 candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "project_id",
    "validation_report_id",
    "validation_activity_id",
    "subject_ids",
    "method",
    "acceptance_criteria",
    "check_status",
    "evidence_ids",
    "limitations",
    "checked_at",
    "checked_by",
    "review_status",
    "report_lifecycle_status",
    "not_applicable_reason",
    "supersedes_report_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.4"
    },
    "record_type": {
      "const": "validation_report"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "validation_report_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
    },
    "validation_activity_id": {
      "type": "string",
      "minLength": 1
    },
    "check_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "blocked",
        "not_applicable",
        "not_run",
        "stale"
      ]
    },
    "evidence_ids": {
      "type": [
        "array",
        "object",
        "number",
        "string",
        "null"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "checked_by": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "needs_revision",
        "rejected",
        "not_applicable"
      ]
    },
    "report_lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "archived"
      ]
    },
    "not_applicable_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "supersedes_report_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "target_domain",
        "out_of_scope_behavior"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_domain": {
          "type": "string",
          "minLength": 1
        },
        "out_of_scope_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids",
        "configuration_ids",
        "input_artifact_ids",
        "external_references"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "configuration_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "input_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "external_references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "external_system",
              "external_id",
              "uri",
              "version_or_revision",
              "retrieved_at",
              "content_sha256",
              "hash_unavailable_reason"
            ],
            "properties": {
              "external_system": {
                "type": "string",
                "minLength": 1
              },
              "external_id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "version_or_revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retrieved_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256OrNull"
              },
              "hash_unavailable_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "description",
        "required",
        "verification_method",
        "pass_condition",
        "failure_condition",
        "evidence_kind"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        },
        "pass_condition": {
          "type": "string",
          "minLength": 1
        },
        "failure_condition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {},
        "comparison_operator": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "tolerance_basis": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "threshold"
            ]
          },
          "then": {
            "required": [
              "comparison_operator",
              "unit",
              "tolerance_basis"
            ]
          }
        }
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "description",
        "scope",
        "status",
        "source_or_rationale"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "source_or_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "description",
        "scope",
        "status",
        "source_or_rationale"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "source_or_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "check_status": {
            "enum": [
              "passed",
              "failed",
              "inconclusive"
            ]
          }
        },
        "required": [
          "check_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          },
          "checked_by": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "checked_at",
          "checked_by"
        ]
      }
    }
  ]
}
