{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:particle-physics-research-skill-benchmark:run-record:1.0",
  "title": "Particle Physics Research Skill Benchmark Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id","pair_id","task_id","arm","repeat","started_at_utc","ended_at_utc","protocol","model","runtime","project_context","task_input","tools","budget","execution","skill","artifacts","evaluation","deviations"],
  "properties": {
    "run_id": {"type":"string","minLength":1},
    "pair_id": {"type":"string","minLength":1},
    "task_id": {"type":"string","minLength":1},
    "arm": {"enum":["no-skill","with-skill"]},
    "repeat": {"type":"integer","minimum":1},
    "started_at_utc": {"type":"string","format":"date-time"},
    "ended_at_utc": {"type":"string","format":"date-time"},
    "protocol": {
      "type":"object",
      "required":["version","commit","environment_lock_sha256","scoring_rubric_sha256","evaluator_manifest_sha256","task_manifest_sha256"],
      "properties":{
        "version":{"const":"1.0"},
        "commit":{"$ref":"#/$defs/commit"},
        "environment_lock_sha256":{"$ref":"#/$defs/sha256"},
        "scoring_rubric_sha256":{"$ref":"#/$defs/sha256"},
        "evaluator_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "task_manifest_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "model":{"type":"object","required":["label","immutable_id","reasoning_effort"],"properties":{"label":{"type":"string","minLength":1},"immutable_id":{"type":["string","null"]},"reasoning_effort":{"type":["string","null"]},"sampling":{"type":["object","null"]},"system_configuration_fingerprint":{"type":["string","null"]}}},
    "runtime":{"type":"object","required":["os","codex_product","codex_version","python_version","architecture","hardware"],"properties":{"os":{"type":"string","minLength":1},"codex_product":{"type":"string","minLength":1},"codex_version":{"type":"string","minLength":1},"cli_version":{"type":["string","null"]},"python_version":{"type":["string","null"]},"architecture":{"type":["string","null"]},"hardware":{"type":["object","null"]}}},
    "project_context":{"type":"object","required":["repository","source_commit","instructions_sha256","workspace_snapshot_sha256","shared_skill_routing_removed"],"properties":{"repository":{"type":["string","null"]},"source_commit":{"anyOf":[{"$ref":"#/$defs/commit"},{"type":"null"}]},"instructions_sha256":{"$ref":"#/$defs/sha256"},"workspace_snapshot_sha256":{"$ref":"#/$defs/sha256"},"shared_skill_routing_removed":{"type":"boolean"}}},
    "task_input":{"type":"object","required":["prompt_sha256","input_manifest_sha256","source_commit","source_files"],"properties":{"prompt_sha256":{"$ref":"#/$defs/sha256"},"input_manifest_sha256":{"$ref":"#/$defs/sha256"},"source_commit":{"anyOf":[{"$ref":"#/$defs/commit"},{"type":"null"}]},"source_files":{"type":"array","items":{"type":"object","required":["repository","commit","path","git_blob_sha1","size_bytes","sha256"],"properties":{"repository":{"type":"string"},"commit":{"$ref":"#/$defs/commit"},"path":{"type":"string"},"git_blob_sha1":{"$ref":"#/$defs/git_sha1"},"size_bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}}}}},
    "tools":{"type":"object","required":["allowlist","network_policy","versions"],"properties":{"allowlist":{"type":"array","items":{"type":"string"}},"network_policy":{"type":"string"},"versions":{"type":"object"}}},
    "budget":{"type":"object","required":["wall_time_seconds","tool_call_limit"],"properties":{"wall_time_seconds":{"type":"number","exclusiveMinimum":0},"token_limit":{"type":["integer","null"],"minimum":1},"tool_call_limit":{"type":"integer","minimum":1}}},
    "execution":{"type":"object","required":["randomization_seed","pair_order","actual_wall_time_seconds","actual_tool_calls","token_count","commands","tool_log_artifact","transcript_artifact","exit_status"],"properties":{"randomization_seed":{"type":"string","minLength":1},"pair_order":{"enum":["A_then_B","B_then_A"]},"actual_wall_time_seconds":{"type":"number","minimum":0},"actual_tool_calls":{"type":"integer","minimum":0},"token_count":{"type":["integer","null"],"minimum":0},"commands":{"type":"array","items":{"type":"string"}},"tool_log_artifact":{"type":"string","minLength":1},"transcript_artifact":{"type":"string","minLength":1},"exit_status":{"type":["integer","null"]}}},
    "skill":{"type":"object","required":["available","source_commit","manifest_sha256","invocation","references_loaded","availability_evidence_artifact"],"properties":{"available":{"type":"boolean"},"source_commit":{"anyOf":[{"$ref":"#/$defs/commit"},{"type":"null"}]},"manifest_sha256":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},"invocation":{"type":["string","null"]},"references_loaded":{"type":"array","items":{"type":"string"}},"availability_evidence_artifact":{"type":"string","minLength":1}}},
    "artifacts":{"type":"array","items":{"type":"object","required":["path","sha256","role"],"properties":{"path":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"},"role":{"type":"string"}}}},
    "evaluation":{"type":"object","required":["hard_gates","dimension_scores","autonomy_score","weighted_score","deterministic_checks","reviewer_assessments","adjudication"],"properties":{
      "hard_gates":{"type":"object","required":["critical_physics_error","fabricated_evidence","destructive_change","false_pass","convention_or_unit_failure"],"properties":{"critical_physics_error":{"$ref":"#/$defs/gate_status"},"fabricated_evidence":{"$ref":"#/$defs/gate_status"},"destructive_change":{"$ref":"#/$defs/gate_status"},"false_pass":{"$ref":"#/$defs/gate_status"},"convention_or_unit_failure":{"$ref":"#/$defs/gate_status"}}},
      "dimension_scores":{"$ref":"#/$defs/dimension_scores"},
      "autonomy_score":{"$ref":"#/$defs/score"},
      "weighted_score":{"type":["number","null"],"minimum":0,"maximum":100},
      "deterministic_checks":{"type":"array","items":{"type":"object","required":["id","version","status","input_sha256","output_sha256","result_artifact"],"properties":{"id":{"type":"string"},"version":{"type":"string"},"status":{"enum":["pass","fail","not_auditable","error"]},"input_sha256":{"$ref":"#/$defs/sha256"},"output_sha256":{"$ref":"#/$defs/sha256"},"result_artifact":{"type":"string"}}}},
      "reviewer_assessments":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["reviewer_id","arm_label_hidden","dimension_scores","autonomy_score","hard_gates"],"properties":{"reviewer_id":{"type":"string","minLength":1},"arm_label_hidden":{"const":true},"dimension_scores":{"$ref":"#/$defs/dimension_scores"},"autonomy_score":{"$ref":"#/$defs/score"},"hard_gates":{"type":"object"}}}},
      "adjudication":{"type":["object","null"],"required":["adjudicator_id","reason","final_dimension_scores","final_autonomy_score"],"properties":{"adjudicator_id":{"type":"string"},"reason":{"type":"string"},"final_dimension_scores":{"$ref":"#/$defs/dimension_scores"},"final_autonomy_score":{"$ref":"#/$defs/score"}}}
    }},
    "deviations":{"type":"array","items":{"type":"string"}}
  },
  "allOf":[
    {"if":{"properties":{"arm":{"const":"no-skill"}},"required":["arm"]},"then":{"properties":{"skill":{"properties":{"available":{"const":false},"source_commit":{"type":"null"},"manifest_sha256":{"type":"null"},"invocation":{"type":"null"},"references_loaded":{"maxItems":0}},"required":["available","source_commit","manifest_sha256","invocation","references_loaded"]}}}},
    {"if":{"properties":{"arm":{"const":"with-skill"}},"required":["arm"]},"then":{"properties":{"skill":{"properties":{"available":{"const":true},"source_commit":{"$ref":"#/$defs/commit"},"manifest_sha256":{"$ref":"#/$defs/sha256"},"invocation":{"type":"string","minLength":1},"references_loaded":{"minItems":1}},"required":["available","source_commit","manifest_sha256","invocation","references_loaded"]}}}}
  ],
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "git_sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "score":{"type":["integer","null"],"minimum":0,"maximum":4},
    "gate_status":{"enum":["pass","fail","not_applicable"]},
    "dimension_scores":{"type":"object","required":["scientific_correctness","independent_validation","reproducibility","evidence_quality","efficiency"],"properties":{"scientific_correctness":{"$ref":"#/$defs/score"},"independent_validation":{"$ref":"#/$defs/score"},"reproducibility":{"$ref":"#/$defs/score"},"evidence_quality":{"$ref":"#/$defs/score"},"efficiency":{"$ref":"#/$defs/score"}}}
  }
}
